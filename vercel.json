{
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://azw2004.vercel.app/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/mmw_control-pannel",
      "destination": "https://azw2004.vercel.app"
    },
    {
      "source": "/mmw_control-pannel/:path*",
      "destination": "https://azw2004.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
